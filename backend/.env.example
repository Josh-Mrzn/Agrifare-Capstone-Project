MONGODB_URI=
PORT=8080
JWT_SECRET=
JWT_EXPIRES_IN=1d
NODE_ENV=development
# Where the web app is served. Verification and activation emails link here.
APP_URL=http://localhost:5173
# Comma-separated allowed origins for production. In development any localhost port is allowed.
# Example: CORS_ORIGINS=https://agrifair.vercel.app
CORS_ORIGINS=
# Optional: your Vercel project name, to also allow its preview deployments
# (agrifair-git-main-you.vercel.app). Leave empty to allow only CORS_ORIGINS.
VERCEL_PROJECT=

# --- Email (OTP codes and report delivery) ---
# Easiest for Railway: Brevo (brevo.com, free 300 emails/day). Create an API key
# under SMTP & API -> API Keys, and verify MAIL_FROM's address under Senders.
# When set, it takes over from the Gmail API and SMTP below.
BREVO_API_KEY=

# Production (Railway): send through the Gmail API over HTTPS. Railway blocks
# outbound SMTP on non-Pro plans, so Gmail SMTP times out there.
# Create an OAuth client (Web application) in Google Cloud with the Gmail API
# enabled, then get a refresh token for agrifairsupport@gmail.com with the
# https://www.googleapis.com/auth/gmail.send scope (OAuth Playground works).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Local development: plain SMTP works (ignored when the GMAIL_* values are set).
# Gmail: SMTP_PASS must be an App Password, not your account password.
# Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# With the Gmail API this must be the Gmail account itself (or one of its aliases).
MAIL_FROM=AgriFair <agrifairsupport@gmail.com>

# --- PayMongo (payment gateway demo, sandbox) ---
# Test secret key from dashboard.paymongo.com -> Developers -> API Keys.
# Use the sk_test_ key: no real money moves. Leave empty to hide online payment.
PAYMONGO_SECRET_KEY=
# Optional: secret of a webhook pointing at <API>/api/payments/paymongo/webhook
# (event checkout_session.payment.paid). Without it, the app's "check payment"
# button still marks orders paid.
PAYMONGO_WEBHOOK_SECRET=

# --- Scheduled jobs ---
# Protects POST /api/jobs/auto-complete (header x-cron-secret). The server
# also runs the job on start and hourly; set this to let an outside scheduler
# (the GitHub Actions workflow) wake it. Empty disables the route.
CRON_SECRET=
